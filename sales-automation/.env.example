# Appointment Booking System Environment Variables
# Copy this file to .env and update with your actual values

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
DATABASE_URL=sqlite:///app.db
# For PostgreSQL: DATABASE_URL=postgresql://username:password@localhost/appointment_db
# For MySQL: DATABASE_URL=mysql://username:password@localhost/appointment_db

# Email Configuration (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# n8n Integration
N8N_API_KEY=your-n8n-api-key-here
WEBHOOK_SECRET=your-webhook-secret-here
APP_BASE_URL=http://localhost:5000

# Admin Configuration
ADMIN_EMAIL=admin@yourcompany.com

# Google Sheets Integration (Optional)
GOOGLE_SHEETS_ID=your-google-spreadsheet-id
GOOGLE_SHEETS_WEBHOOK_URL=https://your-n8n-instance.com/webhook/google-sheets
GOOGLE_CREDENTIALS_FILE=path/to/service-account-credentials.json

# Slack Integration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Microsoft Teams Integration (Optional)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK

# Timezone Settings
DEFAULT_TIMEZONE=UTC
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00

# Automation Settings
DAILY_EXPORT_TIME=08:00
REMINDER_HOURS_BEFORE=24
FOLLOWUP_HOURS_AFTER=24

# Security Settings
API_RATE_LIMIT=100
SESSION_TIMEOUT=3600
CSRF_TOKEN_EXPIRY=3600

# Development Settings
DEBUG=True
TESTING=False
LOG_LEVEL=INFO